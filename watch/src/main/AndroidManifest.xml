<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The optional background session (WatchVoiceService), started only by the user from the
         visible app: replies play and, when the Phone's wake settings include the Watch, the wake
         phrase is heard with the app hidden. POST_NOTIFICATIONS shows its notification with Stop;
         WAKE_LOCK is for short, time-limited CPU holds while it listens, records, sends or plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (Android 11+) for the platform speech recognizer used by the
         wake phrase; without it SpeechRecognizer reports no recognition service. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".WatchApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.HermesVoiceWatch">

        <!-- Not standalone: the Watch only works through the paired Phone. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity
            android:name=".WatchActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: started and stopped only by this app (the visible activity, or Stop in its own notification). -->
        <service
            android:name=".WatchVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- Brings the next wake window of a hidden session after a gap that holds no wake lock (one non-exact alarm, no exact-alarm permission). -->
        <receiver
            android:name=".StandbyAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hv/v1/play/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hv/v1/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/hv/v1/settings" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/hv/v1/wake/epoch" />
            </intent-filter>
        </service>
    </application>
</manifest>
