<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- One short pulse when a wake phrase is accepted, and the recording cues with the screen off. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The optional background relay (PhoneRelayService), switched on only by the user from the
         visible app: Watch requests are answered with this app closed. It is a connected-device
         service (the paired Watch) that may also play replies; it never uses the microphone.
         CHANGE_NETWORK_STATE is declared only because the platform requires one of its listed
         permissions for that service type; the app does not change network state.
         POST_NOTIFICATIONS shows the relay's notification with Stop; WAKE_LOCK is for a
         time-limited CPU hold while a voice turn runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Only for the opt-in background listening (PhoneWakeService), started from the visible app with
         the notification and its Stop showing; the relay never has the microphone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (Android 11+) for the platform speech recognizer used by the foreground
         wake phrase; without it SpeechRecognizer reports no recognition service. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Cleartext is allowed at the platform level only because network security config cannot
         express 100.64.0.0/10; HermesDashboardEndpoint.parse refuses plain http except to loopback
         and Tailscale addresses. -->
    <application
        android:name=".PhoneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesVoice"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: started and stopped only by this app (the visible activity, or Stop in its own notification). -->
        <service
            android:name=".PhoneRelayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />

        <!-- Not exported: the opt-in background listening for the wake phrase, started only from the visible app
             (Settings), stopped there or by Stop in its own notification. -->
        <service
            android:name=".PhoneWakeService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <service
            android:name=".PhoneWatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hv/v1/turn/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/hv/v1/played" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/hv/v1/reader/request" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/hv/v1/wake/claim" />
            </intent-filter>
        </service>
    </application>
</manifest>
