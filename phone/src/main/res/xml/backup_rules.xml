<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore-sealed bearer pair: undecryptable elsewhere and must never migrate. -->
    <exclude domain="sharedpref" path="hermes_voice_secure.xml" />
    <!-- This install's background opt-in and "asked" flag (DeviceLocalFlags): never restored elsewhere. -->
    <exclude domain="sharedpref" path="hermes_voice_device_local.xml" />
    <!-- Replies that ended without audio, kept for a manual Replay on this device only. -->
    <exclude domain="sharedpref" path="hermes_voice_unplayed.xml" />
</full-backup-content>
